---
import Layout from '../../layouts/Layout.astro';
---
<Layout titel="Danke für deine Fotos!">
  <section>
    <div class="wrap-text">
      <span class="eyebrow">Fotos eingereicht</span>
      <h1>Danke, gut Pfad!</h1>
      <p>
        Deine Fotos sind angekommen und liegen jetzt sicher beim Stamm.
        Veröffentlicht wird nichts automatisch – die Stammesführung schaut
        alles durch und meldet sich bei Rückfragen.
      </p>
      <p>
        <a class="btn" href="/fotos">Zur Fotogalerie</a>
      </p>
    </div>
  </section>
</Layout>
