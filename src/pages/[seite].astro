---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import KarteAnfahrt from '../components/KarteAnfahrt.astro';
import KontaktFormular from '../components/KontaktFormular.astro';
import StreetviewHeim from '../components/StreetviewHeim.astro';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  return seiten.map((s) => ({ params: { seite: s.id }, props: { eintrag: s } }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);

// Meta-Description aus dem Seitenanfang ableiten
const klartext = (eintrag.body ?? '')
  .replace(/[#>*_`]|\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/\s+/g, ' ')
  .trim();
const beschreibung = klartext.length > 20 ? klartext.slice(0, 155) + '…' : eintrag.data.untertitel;

// Auf der Kontaktseite sitzt die Karte mitten im Inhalt: nach dem ersten
// Absatz (inkl. eines direkt folgenden Adress-Blocks, falls vorhanden).
let vorKarte: string | null = null;
let nachKarte: string | null = null;
if (eintrag.id === 'kontakt' && eintrag.body) {
  const body = eintrag.body.trim();
  const teile =
    body.match(/^([\s\S]*?\n(?:>[^\n]*\n)+)\s*([\s\S]*)$/) ??
    body.match(/^([\s\S]*?)\n\s*\n([\s\S]*)$/);
  if (teile) {
    vorKarte = (await marked.parse(teile[1])) as string;
    nachKarte = (await marked.parse(teile[2])) as string;
  }
}
---
<Layout titel={eintrag.data.titel} beschreibung={beschreibung}>
  <section>
    <div class={`wrap-text seite-${eintrag.id}`}>
      {eintrag.data.untertitel && <span class="eyebrow">{eintrag.data.untertitel}</span>}
      <h1>{eintrag.data.titel}</h1>
      {vorKarte !== null && nachKarte !== null ? (
        <>
          <div class="prose" set:html={vorKarte} />
          <KarteAnfahrt />
          <div class="prose" set:html={nachKarte} />
        </>
      ) : (
        <>
          {eintrag.id === 'kontakt' && <KarteAnfahrt />}
          <div class="prose">
            <Content />
          </div>
        </>
      )}
      {eintrag.id === 'kontakt' && <KontaktFormular />}
      {eintrag.id === 'heim' && <StreetviewHeim />}
      {eintrag.id === 'heim' && <KarteAnfahrt />}
    </div>
  </section>
</Layout>

<style is:global>
  /* Pfadfinderregeln: nummerierte Listen als Regel-Karten */
  .seite-pfadfinderregeln .prose ol {
    list-style: none;
    counter-reset: regel;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    margin: 1.2rem 0 2rem;
  }
  .seite-pfadfinderregeln .prose ol li {
    counter-increment: regel;
    position: relative;
    background: var(--pfadiblau-hell);
    border-radius: 6px;
    padding: 0.95rem 1.2rem 0.95rem 3.6rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--pfadiblau);
    margin: 0;
  }
  .seite-pfadfinderregeln .prose img {
    max-width: 190px;
    margin: 0.5rem 0 1rem;
  }
  .seite-pfadfinderregeln .prose ol li::before {
    content: counter(regel);
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--woelflingsgelb);
    color: var(--pfadiblau);
    font-weight: 900;
    border-radius: 999px;
  }
</style>
