---
import Layout from '../layouts/Layout.astro';
---
<Layout titel="Seite nicht gefunden">
  <section>
    <div class="wrap-text">
      <span class="eyebrow">Fehler 404</span>
      <h1>Diesen Pfad kennen wir nicht.</h1>
      <p>
        Die Seite, die du suchst, gibt es nicht (mehr). Vielleicht hilft dir
        die <a href="/">Startseite</a>, die <a href="/gruppen">Gruppenübersicht</a>
        oder der <a href="/termine">Terminkalender</a> weiter.
      </p>
    </div>
  </section>
</Layout>
