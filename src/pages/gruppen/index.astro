---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GruppenKarte from '../../components/GruppenKarte.astro';

const gruppen = (await getCollection('gruppen')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
---
<Layout titel="Gruppen" beschreibung="Die Gruppen des Stamm Hubertus Siegen: Meute Schwarzkittel, Sippe Werwolf, Sippe Pegasus und die Gilde.">
  <section>
    <div class="wrap">
      <span class="eyebrow"><img src="/bdp/icon-wald.png" alt="">Von Wölfling bis Gilde</span>
      <h1>Unsere Gruppen</h1>
      <p class="intro">
        Bei uns ist für jedes Alter die passende Gruppe dabei. Neue Gesichter
        sind jederzeit willkommen – komm einfach samstags vorbei und schnupper rein.
      </p>
      <div class="raster">
        {gruppen.map((g) => (
          <GruppenKarte
            id={g.id}
            name={g.data.name}
            stufe={g.data.stufe}
            alter={g.data.alter}
            farbe={g.data.farbe}
            icon={g.data.icon}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro { max-width: 40rem; font-size: 1.1rem; }
  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }
</style>
