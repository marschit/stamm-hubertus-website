---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { KATEGORIEN, alsIso, formatDatum, formatMonat, monatsSchluessel, heimabendSamstage } from '../lib/termine';
import { ladeCloudTermine } from '../lib/nextcloud-termine';

const heute = alsIso(new Date());
const cloudTermine = (await ladeCloudTermine()).filter(
  (t) => alsIso(t.endDatum ?? t.datum) >= heute
);
const lvnrwAnzahl = cloudTermine.filter((t) => t.kategorie === 'lvnrw').length;
const alle = (await getCollection('termine'))
  .filter((t) => alsIso(t.data.endDatum ?? t.data.datum) >= heute)
  .sort((a, b) => a.data.datum.valueOf() - b.data.datum.valueOf());

const gerendert = await Promise.all(
  alle.map(async (t) => ({ termin: t, Inhalt: (await render(t)).Content }))
);

// Auf der Seite nur die Heimabende der nächsten ~10 Wochen zeigen —
// im Kalender-Abo (ICS) bleibt der volle Zeitraum enthalten
const horizont = new Date();
horizont.setUTCDate(horizont.getUTCDate() + 70);
const horizontIso = alsIso(horizont);
const heimabende = heimabendSamstage(heute)
  .filter((iso) => iso <= horizontIso)
  .map((iso) => new Date(iso));

const zeilen = [
  ...gerendert.map((g) => ({ art: 'termin' as const, ...g, iso: alsIso(g.termin.data.datum) })),
  ...cloudTermine.map((t) => ({ art: 'cloud' as const, cloud: t, iso: alsIso(t.datum) })),
  ...heimabende.map((d) => ({ art: 'heimabend' as const, datum: d, iso: alsIso(d) })),
].sort((a, b) => a.iso.localeCompare(b.iso));

const monate = [
  ...new Map(
    [...alle.map((t) => t.data.datum), ...cloudTermine.map((t) => t.datum), ...heimabende].map(
      (d) => [monatsSchluessel(d), d]
    )
  ),
].sort((a, b) => a[0].localeCompare(b[0]));

const feedUrl = new URL('/termine.ics', Astro.site).href;
const webcalUrl = feedUrl.replace(/^https?:/, 'webcal:');
---
<Layout titel="Termine" beschreibung="Alle Termine des Stamm Hubertus Siegen: Gruppenstunden, Lager, Fahrten und Aktionen – mit Kalender-Abo.">
  <section>
    <div class="wrap">
      <span class="eyebrow"><img src="/bdp/icon-kompass.png" alt="">Lager, Fahrten &amp; Aktionen</span>
      <h1>Termine</h1>
      <p class="intro">
        Unser <strong>Heimabend</strong> ist jeden Samstag von 15 bis 17 Uhr im
        Stammesheim – außer in den NRW-Schulferien. Dazu kommen Lager, Fahrten
        und Aktionen. Alles zusammen gibt es unten auch als Kalender-Abo.
      </p>
      <p class="intro-hinweis">
        In seltenen Fällen kann ein Heimabend ausfallen, etwa wegen Krankheit –
        kurzfristige Änderungen erfahrt ihr über eure Gruppenleitung.
      </p>

      <div class="filter" role="group" aria-label="Nach Gruppe filtern">
        <button type="button" data-filter="alle" aria-pressed="true">Alle</button>
        {Object.entries(KATEGORIEN).map(([schluessel, k]) => (
          <button type="button" data-filter={schluessel} aria-pressed="false">
            {k.label}
            {schluessel === 'lvnrw' && lvnrwAnzahl > 0 && (
              <span class="zaehler" title={`${lvnrwAnzahl} Termine des Landesverbands`}>{lvnrwAnzahl}</span>
            )}
          </button>
        ))}
      </div>
      <p class="lv-hinweis">
        Termine unseres Landesverbands (Kurse, Lager, Treffen) blenden wir hier
        nicht automatisch ein – ein Klick auf <strong>BdP NRW</strong> zeigt sie dir.
        Ausschreibungen und alle Infos zu den Landesaktionen findest du auf
        <a href="https://bdpnrw.de/aktionen/">bdpnrw.de/aktionen</a>.
      </p>

      <div class="termine">
        {monate.map(([schluessel, datum]) => (
          <div
            class="monat"
            data-monat={schluessel}
            hidden={zeilen
              .filter((z) => z.iso.slice(0, 7) === schluessel)
              .every((z) => z.art === 'cloud' && z.cloud.kategorie === 'lvnrw')}
          >
            <h2>{formatMonat(datum)}</h2>
            <ul>
              {zeilen
                .filter((z) => z.iso.slice(0, 7) === schluessel)
                .map((z) =>
                  z.art === 'cloud' ? (
                    <li
                      class="termin"
                      data-kategorie={z.cloud.kategorie}
                      data-ende={alsIso(z.cloud.endDatum ?? z.cloud.datum)}
                      hidden={z.cloud.kategorie === 'lvnrw'}
                    >
                      <div class="wann">
                        <span class="tag">{formatDatum(z.cloud.datum)}</span>
                        {z.cloud.endDatum && <span class="bis">bis {formatDatum(z.cloud.endDatum)}</span>}
                        {z.cloud.zeit && <span class="zeit">{z.cloud.zeit} Uhr</span>}
                      </div>
                      <div class="was">
                        <span
                          class={`badge ${KATEGORIEN[z.cloud.kategorie].hell ? 'badge--hell' : ''}`}
                          style={`background:${KATEGORIEN[z.cloud.kategorie].farbe}`}
                        >{KATEGORIEN[z.cloud.kategorie].label}</span>
                        {z.cloud.kategorie === 'lvnrw' ? (
                          <strong>
                            <a class="lv-link" href="https://bdpnrw.de/aktionen/" title="Infos und Ausschreibung auf bdpnrw.de">
                              {z.cloud.titel} <span class="extern" aria-hidden="true">↗</span>
                            </a>
                          </strong>
                        ) : (
                          <strong>{z.cloud.titel}</strong>
                        )}
                        {z.cloud.ort && <span class="ort">{z.cloud.ort}</span>}
                        {z.cloud.beschreibung && <div class="beschreibung"><p>{z.cloud.beschreibung}</p></div>}
                      </div>
                    </li>
                  ) : z.art === 'heimabend' ? (
                    <li class="termin termin--heimabend" data-kategorie="stamm" data-ende={z.iso}>
                      <div class="wann">
                        <span class="tag">{formatDatum(z.datum)}</span>
                        <span class="zeit">15:00 – 17:00 Uhr</span>
                      </div>
                      <div class="was">
                        <strong>Heimabend</strong>
                        <span class="ort">Stammesheim</span>
                      </div>
                    </li>
                  ) : (
                    <li
                      class="termin"
                      data-kategorie={z.termin.data.kategorie}
                      data-ende={alsIso(z.termin.data.endDatum ?? z.termin.data.datum)}
                    >
                      <div class="wann">
                        <span class="tag">{formatDatum(z.termin.data.datum)}</span>
                        {z.termin.data.endDatum && (
                          <span class="bis">bis {formatDatum(z.termin.data.endDatum)}</span>
                        )}
                        {z.termin.data.zeit && <span class="zeit">{z.termin.data.zeit} Uhr</span>}
                      </div>
                      <div class="was">
                        <span
                          class={`badge ${KATEGORIEN[z.termin.data.kategorie].hell ? 'badge--hell' : ''}`}
                          style={`background:${KATEGORIEN[z.termin.data.kategorie].farbe}`}
                        >{KATEGORIEN[z.termin.data.kategorie].label}</span>
                        <strong>{z.termin.data.titel}</strong>
                        {z.termin.data.ort && <span class="ort">{z.termin.data.ort}</span>}
                        <div class="beschreibung"><z.Inhalt /></div>
                      </div>
                    </li>
                  )
                )}
            </ul>
          </div>
        ))}
        <p class="leer" hidden>Aktuell stehen hier keine Termine – schau bald wieder vorbei!</p>
      </div>

      <div class="abo">
        <h2>Kalender abonnieren</h2>
        <p>
          Abonniere unseren Kalender, dann erscheinen neue Termine automatisch auf
          deinem Handy oder Computer:
        </p>
        <p>
          <a class="btn btn--blau" href={webcalUrl}>In Kalender-App öffnen</a>
        </p>
        <p class="abo-url">
          Oder füge diese Adresse in deiner Kalender-App als Abonnement hinzu:<br />
          <code>{feedUrl}</code>
        </p>
        <p class="abo-hinweis">
          Nur die Termine einer Gruppe? Dafür gibt es eigene Kalender, z.&nbsp;B.
          {Object.entries(KATEGORIEN).map(([schluessel, k], i) => (
            <>{i > 0 && ' · '}<a href={`/termine-${schluessel}.ics`}>{k.label}</a></>
          ))}
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Vergangene Termine ausblenden (die Seite wird nur beim Deploy neu gebaut)
  const heute = new Date().toLocaleDateString('sv-SE');
  document.querySelectorAll<HTMLElement>('.termin').forEach((t) => {
    if ((t.dataset.ende ?? '') < heute) t.remove();
  });

  const knoepfe = document.querySelectorAll<HTMLButtonElement>('.filter button');
  function anwenden(filter: string) {
    knoepfe.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.filter === filter)));
    document.querySelectorAll<HTMLElement>('.termin').forEach((t) => {
      // Landesverbands-Termine nur zeigen, wenn gezielt gefiltert wird
      t.hidden =
        filter === 'alle'
          ? t.dataset.kategorie === 'lvnrw'
          : t.dataset.kategorie !== filter;
    });
    document.querySelectorAll<HTMLElement>('.monat').forEach((m) => {
      m.hidden = !m.querySelector('.termin:not([hidden])');
    });
    const leer = document.querySelector<HTMLElement>('.leer');
    if (leer) leer.hidden = !!document.querySelector('.monat:not([hidden])');
  }
  knoepfe.forEach((k) => k.addEventListener('click', () => anwenden(k.dataset.filter!)));
  anwenden('alle');
</script>

<style>
  .intro { max-width: 44rem; }
  .intro-hinweis {
    max-width: 44rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: -0.3rem;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0.5rem;
  }
  .filter button {
    font: inherit;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 2px solid var(--pfadiblau);
    background: transparent;
    color: var(--pfadiblau);
    cursor: pointer;
  }
  .filter button[aria-pressed='true'] {
    background: var(--pfadiblau);
    color: var(--papier);
  }
  .zaehler {
    display: inline-block;
    min-width: 1.35em;
    margin-left: 0.35em;
    padding: 0.05em 0.35em;
    background: var(--woelflingsgelb);
    color: var(--pfadiblau);
    border-radius: 999px;
    font-size: 0.75em;
    font-weight: 900;
    text-align: center;
  }
  .lv-hinweis {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0.2rem 0 0;
  }

  .monat h2 {
    font-size: 1.15rem;
    margin: 2.2rem 0 0.6rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--woelflingsgelb);
    display: inline-block;
  }
  .monat ul { list-style: none; margin: 0; padding: 0; }

  /* display:flex würde das hidden-Attribut sonst aushebeln */
  .termin[hidden],
  .monat[hidden] {
    display: none !important;
  }
  .termin {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--linie);
  }
  .termin--heimabend { padding: 0.5rem 0; }
  .termin--heimabend .wann { flex-direction: row; gap: 0 0.8rem; align-items: baseline; }
  .termin--heimabend .tag { font-weight: 700; }
  .termin--heimabend .was { flex-direction: row; gap: 0 0.8rem; align-items: baseline; }
  .termin--heimabend .was strong {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }
  .wann {
    flex: 0 0 11.5rem;
    display: flex;
    flex-direction: column;
    font-variant-numeric: tabular-nums;
  }
  .tag { font-weight: 900; color: var(--pfadiblau); }
  .bis, .zeit { font-size: 0.9rem; color: var(--ink-soft); }
  .was { flex: 1 1 18rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .was strong { font-weight: 900; font-size: 1.15rem; color: var(--pfadiblau); }
  .lv-link { color: var(--pfadiblau); text-decoration: none; }
  .lv-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .extern { font-size: 0.75em; }
  .ort { font-size: 0.9rem; color: var(--ink-soft); }
  .beschreibung { font-size: 0.95rem; }
  .beschreibung :global(p) { margin: 0.3em 0 0; }
  .badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
  .badge--hell { color: var(--pfadiblau); }

  .abo {
    margin-top: 3rem;
    background: var(--pfadiblau-hell);
    border-radius: 4px;
    padding: 1.5rem 1.75rem 1.75rem;
  }
  .abo h2 { font-size: 1.3rem; }
  .abo-url code {
    display: inline-block;
    margin-top: 0.3rem;
    background: #fff;
    border: 1px solid var(--linie);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    font-size: 0.85rem;
    word-break: break-all;
  }
  .abo-hinweis { font-size: 0.9rem; color: var(--ink-soft); margin-bottom: 0; }
</style>
