---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import einstellungen from '../data/einstellungen.json';

interface Props {
  titel?: string;
  beschreibung?: string;
  bild?: string;
}
const { titel, beschreibung, bild } = Astro.props;
const seitentitel = titel
  ? `${titel} – ${einstellungen.verein}`
  : `${einstellungen.verein} – ${einstellungen.claim}`;
const beschreibungstext = beschreibung ?? 'Pfadfinden in Siegen: Der BdP Stamm Hubertus Siegen e.V. – jeden Samstag von 15 bis 17 Uhr am Seilereiweg 8.';
const kanonisch = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const vorschaubild = new URL(bild ?? '/bilder/gruppenfoto.jpg', Astro.site).href;

const gruppenEintraege = (await getCollection('gruppen')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);

const nav = [
  { href: '/', label: 'Start' },
  {
    href: '/ueber-uns',
    label: 'Über uns',
    unter: [
      { href: '/gruppen', label: 'Unsere Gruppen' },
      ...gruppenEintraege.map((g) => ({ href: `/gruppen/${g.id}`, label: g.data.name })),
    ],
  },
  { href: '/termine', label: 'Termine' },
  { href: '/aktuelles', label: 'Aktuelles' },
  { href: '/fotos', label: 'Fotos' },
  { href: '/heim', label: 'Heim mieten' },
  { href: '/foerderverein', label: 'Förderverein' },
  { href: '/spenden', label: 'Spenden' },
  { href: '/kontakt', label: 'Kontakt' },
];
const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibungstext} />
    <link rel="canonical" href={kanonisch} />
    <meta name="theme-color" content="#0e4278" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={einstellungen.verein} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibungstext} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={vorschaubild} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/bilder/hubertus-logo-192.png" />
    <link rel="apple-touch-icon" href="/bilder/hubertus-logo-192.png" />
    <link rel="preload" href="/fonts/einfachBdP-Superfett.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/einfachBdP-Klassisch.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf">
      <div class="wrap kopf-innen">
        <a href="/" class="marke" aria-label="Startseite Stamm Hubertus Siegen">
          <img class="marke-logo" src="/bilder/hubertus-logo.svg" alt="" width="52" height="52" />
          <span class="marke-name">Stamm Hubertus<br />Siegen</span>
          <span class="marke-trenner" aria-hidden="true"></span>
          <img class="marke-bdp" src="/bdp/klilie-neu.svg" alt="Bund der Pfadfinder*innen" width="45" height="44" />
        </a>
        <button class="nav-knopf" type="button" aria-expanded="false" aria-controls="hauptnav" aria-label="Menü öffnen">
          <span></span><span></span><span></span>
        </button>
        <nav id="hauptnav" aria-label="Hauptnavigation">
          <ul>
            {nav.map((n) => (
              <li class={'unter' in n ? 'hat-unter' : undefined}>
                <a
                  href={n.href}
                  aria-current={pfad === n.href ? 'page' : undefined}
                  class={'unter' in n && (pfad.startsWith('/gruppen') || pfad === n.href) ? 'eltern-aktiv' : undefined}
                >{n.label}</a>
                {'unter' in n && (
                  <button class="unter-knopf" type="button" aria-expanded="false" aria-label={`Untermenü ${n.label} aufklappen`}>▾</button>
                )}
                {'unter' in n && n.unter && (
                  <ul class="untermenu">
                    {n.unter.map((u) => (
                      <li>
                        <a href={u.href} aria-current={pfad === u.href ? 'page' : undefined}>{u.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <script>
      const knopf = document.querySelector<HTMLButtonElement>('.nav-knopf')!;
      const menue = document.getElementById('hauptnav')!;
      knopf.addEventListener('click', () => {
        const offen = menue.classList.toggle('offen');
        knopf.setAttribute('aria-expanded', String(offen));
        knopf.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menue.classList.contains('offen')) knopf.click();
      });
      document.querySelectorAll<HTMLButtonElement>('.unter-knopf').forEach((k) => {
        k.addEventListener('click', () => {
          const unter = k.nextElementSibling as HTMLElement;
          const offen = unter.classList.toggle('offen');
          k.setAttribute('aria-expanded', String(offen));
        });
      });
    </script>

    <footer class="fuss">
      <div class="wrap fuss-innen">
        <div class="fuss-marke">
          <img src="/bilder/hubertus-logo.svg" alt="" width="64" height="64" />
          <div>
            <strong>{einstellungen.verein}</strong><br />
            {einstellungen.adresse}<br />
            <a href={`mailto:${einstellungen.email}`}>{einstellungen.email}</a>
          </div>
        </div>
        <div class="fuss-links">
          <a href="/termine">Termine</a>
          <a href="/fotos-einreichen">Fotos einreichen</a>
          <a href="/spenden">Spenden</a>
          <a href={einstellungen.instagram}>Instagram</a>
          <a href={einstellungen.facebook}>Facebook</a>
          <a href="https://cloud.stamm-hubertus-siegen.de">Vereins-Cloud</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </div>
        <p class="fuss-bund">
          <span>Mitglied im</span>
          <img src="/bdp/bundeszeichen-negativ.svg" alt="Bund der Pfadfinder*innen" height="38" />
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--woelflingsgelb);
    color: var(--pfadiblau);
    padding: 0.5rem 1rem;
    z-index: 10;
  }
  .skip:focus { left: 0; }

  .kopf {
    background: var(--papier);
    border-bottom: 4px solid var(--pfadiblau);
    position: relative;
  }
  .kopf-innen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .nav-knopf {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.6rem;
    background: transparent;
    border: 2px solid var(--pfadiblau);
    border-radius: 4px;
    cursor: pointer;
  }
  .nav-knopf span {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--pfadiblau);
    transition: transform 180ms ease, opacity 180ms ease;
  }
  .nav-knopf[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .nav-knopf[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav-knopf[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  .marke {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
  }
  .marke img { display: block; }
  .marke-logo { border-radius: 50%; }
  .marke-trenner {
    width: 1px;
    height: 2.5rem;
    background: var(--linie);
    margin: 0 0.2rem;
  }
  @media (max-width: 480px) {
    .marke-trenner, .marke-bdp { display: none; }
  }
  .marke-name {
    font-weight: 900;
    line-height: 1.1;
    font-size: 1.05rem;
    color: var(--pfadiblau);
    letter-spacing: 0.01em;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--pfadiblau);
    padding: 0.3rem 0;
    border-bottom: 3px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--woelflingsgelb); }
  nav a[aria-current='page'], nav a.eltern-aktiv { border-bottom-color: var(--woelflingsgelb); }

  .hat-unter { position: relative; }
  .unter-knopf {
    font: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--pfadiblau);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.3rem 0.2rem;
    transition: transform 150ms ease;
  }
  .unter-knopf[aria-expanded='true'] { transform: rotate(180deg); }
  .untermenu {
    display: none;
    position: absolute;
    top: 100%;
    left: -0.75rem;
    min-width: 13rem;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    background: var(--papier);
    border: 1px solid var(--linie);
    border-top: 3px solid var(--woelflingsgelb);
    border-radius: 0 0 6px 6px;
    box-shadow: 0 12px 28px rgb(14 66 120 / 0.18);
    z-index: 30;
  }
  .hat-unter:hover .untermenu,
  .hat-unter:focus-within .untermenu,
  .untermenu.offen { display: flex; }
  .untermenu a {
    display: block;
    padding: 0.5rem 0.9rem;
    border-bottom: none;
    font-weight: 700;
  }
  .untermenu a:hover,
  .untermenu a[aria-current='page'] {
    background: var(--pfadiblau-hell);
    border-bottom: none;
  }
  .untermenu li:first-child a { border-bottom: 1px solid var(--linie); }

  @media (max-width: 900px) {
    .nav-knopf { display: flex; }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--papier);
      border-bottom: 4px solid var(--pfadiblau);
      box-shadow: 0 14px 30px rgb(14 66 120 / 0.18);
      z-index: 20;
    }
    nav.offen { display: block; }
    nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1rem;
    }
    nav li + li { border-top: 1px solid var(--linie); }
    nav a {
      display: block;
      padding: 0.85rem 0.25rem;
      font-size: 1.05rem;
      border-bottom: none;
      border-left: 4px solid transparent;
    }
    nav a[aria-current='page'] {
      border-bottom: none;
      border-left-color: var(--woelflingsgelb);
      padding-left: 0.75rem;
    }
    nav a.eltern-aktiv { border-bottom: none; }
    .hat-unter {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    .hat-unter > a { flex: 1; }
    .unter-knopf { font-size: 1rem; padding: 0.5rem 0.9rem; }
    .untermenu {
      display: none;
      flex-basis: 100%;
      position: static;
      min-width: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0 0 0.4rem 1.1rem;
      background: transparent;
    }
    .untermenu a { font-weight: 400; font-size: 1rem; padding: 0.55rem 0.25rem; }
    .untermenu li:first-child a { border-bottom: none; }
    .untermenu a:hover { background: transparent; }
    .untermenu li + li { border-top: 1px solid var(--linie); }
  }

  .fuss {
    margin-top: 4rem;
    background: var(--pfadiblau);
    color: var(--papier);
  }
  .fuss-innen {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    align-items: flex-start;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .fuss a { color: var(--papier); }
  .fuss-marke { display: flex; gap: 1rem; align-items: center; }
  .fuss-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-weight: 700;
  }
  .fuss-bund {
    width: 100%;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(253 252 248 / 0.25);
    font-size: 0.9rem;
    color: rgb(253 252 248 / 0.75);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .fuss-bund img { height: 2.4rem; width: auto; display: block; }
</style>
